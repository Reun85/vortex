<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Which "version" of the scripts to build: V1, V2 or V3. -->
    <Variant Condition="'$(Variant)' == ''">V1</Variant>
    <DefineConstants>$(DefineConstants);$(Variant)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Delta.Scripting/Delta.Scripting.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
